rules_version = '2';

// Regras REALMENTE deployadas em produção hoje (coladas do console pelo
// usuário em 2026-09-10, ver docs/security/firestore-rules-deployed.md para
// a análise completa). Versionadas aqui só para ficarem rastreadas — este
// arquivo ainda NÃO está referenciado por um deploy automático; qualquer
// mudança precisa ser aplicada manualmente (Console ou `firebase deploy
// --only firestore:rules`) e testada contra o app antigo antes de seguir
// pro próximo passo do endurecimento (FASE 11 da migração).
//
// Achados principais (⚠️ = risco):
//   - catch-all `/{document=**}` com `allow read;` incondicional: ⚠️ o BANCO
//     INTEIRO é legível sem login, inclusive PII de `Usuarios`.
//   - `Pets`: leitura pública (mesmo sem o catch-all, já seria assim).
//   - `Localizacoes`: ⚠️ leitura E ESCRITA públicas — qualquer um cria, edita
//     ou apaga qualquer registro.
//   - `Usuarios` update/delete comparam com `resource.data.uid`, campo que só
//     existe em 1 dos 18 documentos reais — na prática, update/delete falham
//     pra quase todo mundo (fail-closed, não é um risco, é uma inconsistência).
service cloud.firestore {
  match /databases/{database}/documents {
    match /Usuarios/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    match /Pets/{petId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /Localizacoes/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}
